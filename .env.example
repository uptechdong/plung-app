# ============================================================
#  CONTOH KONFIGURASI - SALIN KE .env LALU ISI SESUAI MESIN ANDA
# ============================================================
#  Cara pakai:
#    1. Salin file ini menjadi .env
#       cp .env.example .env      (Linux/Mac)
#       copy .env.example .env    (Windows)
#    2. Buat APP_KEY:
#       php artisan key:generate
#
#  File .env TIDAK boleh di-commit ke git. Yang dikomit hanya
#  .env.example ini, karena isinya tidak berisi nilai rahasia.
# ============================================================

APP_NAME="PLUNG!"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Aplikasi ini berbahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- LOG ---
# Saat sudah dideploy, LOG_LEVEL=warning agar tidak membanjiri
# storage/logs dengan permintaan normal.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Project ini memakai MySQL, bukan SQLite.
# Buat database kosong lebih dulu, lalu jalankan:
#    php artisan migrate --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plung_app
DB_USERNAME=root
DB_PASSWORD=

# --- SESSION ---
# WAJIB database.Tabel "sessions" dibuat oleh migration
# 2026_10_04_000001_create_sessions_table.php.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- FILESYSTEM ---
# WAJIB public. Foto profil dan bukti setoran disimpan di
# storage/app/public lalu disajikan lewat symlink public/storage.
#   Windows tanpa symlink: jalankan
#     php artisan storage:link
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- REDIS (tidak dipakai project ini, dibiarkan default) ---
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL (belum dipakai; notifikasi memakai modal di dalam aplikasi) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS / S3 (tidak dipakai) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"