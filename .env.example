# ============================================================
#  CONTOH KONFIGURASI - SALIN KE .env LALU ISI SESUAI MESIN ANDA
# ============================================================
#  Cara pakai:
#    1. Salin file ini menjadi .env
#       cp .env.example .env      (Linux/Mac)
#       copy .env.example .env    (Windows)
#    2. Buat APP_KEY:
#       php artisan key:generate
#
#  File .env TIDAK boleh di-commit ke git. Yang dikomit hanya
#  .env.example ini, karena isinya tidak berisi nilai rahasia.
# ============================================================

APP_NAME="PLUNG!"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Aplikasi ini berbahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- LOG ---
# Saat sudah dideploy, LOG_LEVEL=warning agar tidak membanjiri
# storage/logs dengan permintaan normal.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Project ini memakai MySQL, bukan SQLite.
# Buat database kosong lebih dulu, lalu jalankan:
#    php artisan migrate --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plung_app
DB_USERNAME=root
DB_PASSWORD=

# --- SESSION ---
# WAJIB database.Tabel "sessions" dibuat oleh migration
# 2026_10_04_000001_create_sessions_table.php.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- FILESYSTEM ---
# LOKAL: symlink public/storage -> storage/app/public. Kalau symlink
# gagal di Windows, jalankan:
#     php artisan storage:link
FILESYSTEM_DISK=public

# Disk khusus foto profil & bukti setoran (lihat config/filesystems.php).
# Semua pemanggilan kode memakai disk ini, jadi pindah ke hosting dengan
# filesystem read-only cukup lewat environment variable, tanpa ubah kode.
#
# LOKAL (default): file ditulis ke storage/app/public
FOTO_DRIVER=local
# LOKAL: URL dasar untuk membaca file-nya
FOTO_URL=${APP_URL}/storage

# HOSTING (mis. Vercel): filesystem-nya read-only, jadiWAJIB object storage.
# Pakai layanan S3-compatible: Cloudflare R2, AWS S3, atau TiDB/Backblaze.
#   FOTO_DRIVER=s3
#   FOTO_KEY=...
#   FOTO_SECRET=...
#   FOTO_BUCKET=nama-bucket
#   FOTO_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   FOTO_URL=https://cdn.domain-anda.com
# Catatan: bucket harus bisa dibaca publik, atau URL-nya dibuat permanen,
# karena file ditambahkan dari server lalu dibaca langsung browser.

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- HOSTING TANPA FILESYSTEM TULIS (Vercel) ---
# Folder storage/ dan bootstrap/ hanya bisa dibaca di Vercel, sedangkan
# Laravel butuh menulis ke sana. Arahkan semua path itu ke /tmp.
# Isi blok ini HANYA kalau deploy ke Vercel, jangan di mesin lokal.
#
# VIEW_COMPILED_PATH=/tmp/views
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_SERVICES_CACHE=/tmp/services.php
# APP_EVENTS_CACHE=/tmp/events.php
# SESSION_DRIVER=cookie
# CACHE_STORE=database
# QUEUE_CONNECTION=sync
# LOG_CHANNEL=stderr

# --- REDIS (tidak dipakai project ini, dibiarkan default) ---
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL (belum dipakai; notifikasi memakai modal di dalam aplikasi) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS / S3 (tidak dipakai) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"